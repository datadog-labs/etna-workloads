 /*
+** Create a "tab.col" expression that refers to column iCol of the table
+** pItem by its name or alias, rather than by its position in the FROM list.
+*/
+static Expr *joinColumnByName(Parse *pParse, SrcItem *pItem, int iCol){
+  sqlite3 *db = pParse->db;
+  const char *zTab = pItem->zAlias ? pItem->zAlias : pItem->pSTab->zName;
+  Expr *pCol = sqlite3Expr(db, TK_ID, pItem->pSTab->aCol[iCol].zCnName);
+  Expr *pTab = sqlite3Expr(db, TK_ID, zTab);
+  return sqlite3PExpr(pParse, TK_DOT, pTab, pCol);
+}
