 ** This is the collating function named "RTRIM" which is always
 ** available.  Ignore trailing spaces.
 */
+/*
+** Return true if the buffer z[0..n-1] contains all spaces.
+*/
+static int allSpaces(const char *z, int n){
+  while( n>0 && z[--n]==' ' ){}
+  return n==0;
+}
