+// inline processes the calls within inlinedCall (transitive inlining)
+// immediately, and only then stores inlinedCall into paren.
+func (s *inlClosureState) inline(state *devirtualize.State, paren *ir.ParenExpr, origCall *ir.CallExpr, inlinedCall *ir.InlinedCallExpr) {
+	start := len(s.parens)
+	ir.EditChildren(inlinedCall, s.mark) // mark may append to parens
+	for i := start; i < len(s.parens); i++ {
+		s.resolve(state, i)
+		if oc, ic := s.edit(state, i); ic != nil {
+			s.inline(state, s.parens[i], oc, ic)
+		}
+	}
+	paren.X = inlinedCall
+	state.InlinedCall(s.fn, origCall, inlinedCall)
+}
