+// renameCalleeTParams calls renameTParams only for self-recursive calls, that is
+// if the first type parameter of the callee is the first type parameter of the
+// enclosing function declaration.
+func (check *Checker) renameCalleeTParams(pos syntax.Pos, tparams []*TypeParam, typ Type) ([]*TypeParam, Type) {
+	selfRecursive := check.sig != nil && check.sig.tparams.Len() > 0 && tparams[0] == check.sig.tparams.At(0)
+	if !selfRecursive {
+		return tparams, typ
+	}
+	return check.renameTParams(pos, tparams, typ)
+}
+
 // renameTParams renames the type parameters in the given type such that each type
 // parameter is given a new identity. renameTParams returns the new type parameters
 // and updated type. If the result type is unchanged from the argument type, none
