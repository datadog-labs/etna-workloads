+// emitKeepAlive emits runtime.KeepAlive calls for the variables whose
+// lifetime was extended by calls to //go:uintptrkeepalive functions.
+func (o *orderState) emitKeepAlive() {
+	for _, v := range o.keepAlive {
+		pos := v.Pos()
+		arg := ir.NewConvExpr(pos, ir.OCONV, types.Types[types.TUNSAFEPTR], typecheck.NodAddr(v))
+		call := typecheck.Call(pos, typecheck.LookupRuntime("KeepAlive"), ir.Nodes{arg}, false).(*ir.CallExpr)
+		call.IsCompilerVarLive = true
+		call.NoInline = true
+		o.out = append(o.out, call)
+	}
+	o.keepAlive = o.keepAlive[:0]
+}
