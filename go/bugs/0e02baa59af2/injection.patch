+// shorten bitwise AND/TESTQ if upper 32 bits are known to be zero.
+(ANDQ x y) && (ZeroUpper32Bits(x, 3) || ZeroUpper32Bits(y, 3)) => (ANDL x y)
+(TESTQ x y) && (ZeroUpper32Bits(x, 3) || ZeroUpper32Bits(y, 3)) => (TESTL x y)
+
