 /// factor as an argument lets callers hoist `10^precision` out of a per-element
 /// loop when the precision is constant.
 fn truncate_with_factor<F: Float>(x: F, factor: F) -> F {
-    (x * factor).trunc() / factor
+    (x * factor).round() / factor
 }
 
