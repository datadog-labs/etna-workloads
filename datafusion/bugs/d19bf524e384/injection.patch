+    /// Add filters' equivalence info
+    fn add_filter_equivalence_info(
+        mut self,
+        filter: Arc<dyn PhysicalExpr>,
+    ) -> Result<Self> {
+        let cache = Arc::make_mut(&mut self.cache);
+        for expr in split_conjunction(&filter) {
+            if let Some(b) = expr.downcast_ref::<BinaryExpr>()
+                && b.op() == &Operator::Eq
+            {
+                cache
+                    .eq_properties
+                    .add_equal_conditions(Arc::clone(b.left()), Arc::clone(b.right()))?
+            }
+        }
+        Ok(self)
+    }
