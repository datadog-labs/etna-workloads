+/* Pre-3.15.2 behaviour: an optional field (one that defaults to None) that
+ * is neither set on the instance nor given in 'kwargs' (i.e., absent from
+ * 'payload') is treated as required. */
+static int
+ast_type_replace_check_missing(PyObject *self, PyObject *payload,
+                               PyObject *fields)
+{
+    if (fields == NULL) {
+        return 0;
+    }
+    PyObject *field_types = NULL;
+    if (PyObject_GetOptionalAttr((PyObject*)Py_TYPE(self),
+                                 &_Py_ID(_field_types),
+                                 &field_types) < 0)
+    {
+        return -1;
+    }
+    if (field_types == NULL) {
+        return 0;
+    }
+    Py_ssize_t pos = 0;
+    PyObject *field_name, *field_type;
+    while (PyDict_Next(field_types, &pos, &field_name, &field_type)) {
+        if (!_PyUnion_Check(field_type)) {
+            continue;
+        }
+        int rc = PyDict_Contains(payload, field_name);
+        if (rc == 0) {
+            PyErr_Format(PyExc_TypeError,
+                         "%.400s.__replace__ missing 1 keyword argument: %R.",
+                         _PyType_Name(Py_TYPE(self)), field_name);
+            rc = -1;
+        }
+        if (rc < 0) {
+            Py_DECREF(field_types);
+            return -1;
+        }
+    }
+    Py_DECREF(field_types);
+    return 0;
+}
+
 /* copy.replace() support (shallow copy) */
 static PyObject *
 ast_type_replace(PyObject *self, PyObject *args, PyObject *kwargs)
@@ -1336,6 +1378,11 @@
     if (kwargs && PyDict_Update(payload, kwargs) < 0) {
         goto cleanup;
     }
+    if (dict) {
+        if (ast_type_replace_check_missing(self, payload, fields) < 0) {
+            goto cleanup;
+        }
+    }
     result = PyObject_Call(type, empty_tuple, payload);
 cleanup:
     Py_XDECREF(payload);
