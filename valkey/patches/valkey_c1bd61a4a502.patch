 /* ========================== OP Array API ============================ */
 
+/* Used to update a placeholder previously created using `serverOpArrayAppendPlaceholder`.
+ * We assume the updated placeholder has no target set yet (otherwise its not a placeholder). */
+void serverOpArraySet(serverOpArray *oa, int dbid, robj **argv, int argc, int target, int slot, int index) {
+    serverOp *op = oa->ops + index;
+    serverAssert(!op->target);
+    op->dbid = dbid;
+    op->argv = argv;
+    op->argc = argc;
+    op->target = target;
+    op->slot = slot;
+    oa->numops++;
+}
+
+/* Append an operation to the given serverOpArray. Special case is when used
+ * with target 0, in this case the operation is a placeholder that is expected
+ * to be filled later on using serverOpArraySet. */
