     }
 
     if (prev_capacity != oa->capacity) oa->ops = zrealloc(oa->ops, sizeof(serverOp) * oa->capacity);
-    op = oa->ops + oa->numops;
+    int idx = oa->used;
+    op = oa->ops + idx;
     op->dbid = dbid;
     op->argv = argv;
