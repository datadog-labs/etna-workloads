+
+void serverOpArrayTrim(serverOpArray *oa) {
+    if (!oa->used) return;
+    serverOp *last_op = oa->ops + (oa->used - 1);
+    /* last op is an unused placeholder, we can remove it */
+    if (!last_op->target) --oa->used;
+}
+
+int serverOpArrayAppendPlaceholder(serverOpArray *oa) {
+    return serverOpArrayAppend(oa, 0, NULL, 0, 0, -1);
 }
 
