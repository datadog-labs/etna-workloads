SELECT r3.c0 AS i, r3.c1 AS v
FROM (
        SELECT
            r0.c0 AS c0,
            "system".main.cast_to_type(
                CASE
                    WHEN ((r0.c0 = CAST(4 AS INTEGER))) THEN (
                        CASE
                            WHEN (FALSE) THEN ("system".main.struct_pack(v := CAST(NULL AS VARCHAR) COLLATE NOCASE))
                            ELSE NULL
                        END)
                    ELSE "system".main.cast_to_type("system".main.struct_pack(v := r0.c1 COLLATE NOCASE), CASE
                                                                                                              WHEN (FALSE) THEN ("system".main.struct_pack(v := CAST(NULL AS VARCHAR) COLLATE NOCASE))
                                                                                                              ELSE NULL
                                                                                                          END)
                END, CASE
                         WHEN (FALSE) THEN ("system".main.struct_pack(v := CAST(NULL AS VARCHAR) COLLATE NOCASE))
                         ELSE NULL
                     END) AS c1
        FROM (
                VALUES (CAST(0 AS INTEGER), CAST('A' AS VARCHAR)),
                    (CAST(1 AS INTEGER), CAST('a' AS VARCHAR)),
                    (CAST(2 AS INTEGER), CAST('B' AS VARCHAR)),
                    (CAST(3 AS INTEGER), CAST(NULL AS VARCHAR)),
                    (CAST(4 AS INTEGER), CAST('A' AS VARCHAR))
            ) AS r0(c0, c1)
    ) AS r3(c0, c1)
ORDER BY r3.c0 ASC NULLS LAST
