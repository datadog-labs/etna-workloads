remap_struct(struct_pack(id := id, m := "map"(list_value(1, 2), list_value('a', 'b'))), CAST(NULL AS STRUCT(id INTEGER, m2 MAP(INTEGER, VARCHAR))), struct_pack(id := 'id', m2 := "row"('m', struct_pack("key" := 'key', "value" := 'value'))), NULL)
{'id': 0, 'm2': {1=a, 2=b}}
