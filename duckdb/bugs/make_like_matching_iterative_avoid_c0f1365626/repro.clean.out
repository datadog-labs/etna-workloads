like_escape(repeat('a', 30000), repeat('%a', 30000), '')
true
like_escape(repeat('a', 29999), repeat('%a', 30000), '')
false
(repeat('a', 30000) ~~ repeat('%a', 30000))
true
ilike_escape((repeat('A', 30000) || 'b'), (repeat('%a', 30000) || '%c'), '')
false
like_escape(repeat('ab', 1000), (repeat('%a_', 1000) || '%'), '\')
true
like_escape('x%y%z', '%\%%\%%', '\')
true
like_escape('x%y%z', '%\%%\%%\%%', '\')
false
