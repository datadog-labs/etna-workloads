SELECT
    CAST("system".main.union_tag(r2.c0) AS ENUM ('v')) AS "union_tag(u)",
    r2.c1 AS "union_extract(u, 'v')",
    ("system".main.lower(r2.c1) COLLATE NOCASE = CAST('a' COLLATE NOCASE AS VARCHAR)) AS "(union_extract(u, 'v') = 'a')",
    CAST(FALSE AS BOOLEAN) AS "(u IS NULL)"
FROM (
        SELECT
            r1.c0 AS c0,
            CAST("system".main.union_extract(r1.c0, CAST('v' AS VARCHAR)) AS VARCHAR) COLLATE NOCASE AS c1
        FROM (
                SELECT "system".main.union_value(v := 'A' COLLATE NOCASE) AS c0
            ) AS r1(c0)
    ) AS r2(c0, c1)
