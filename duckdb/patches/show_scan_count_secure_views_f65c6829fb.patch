-		node.children.clear();
+	if (node.GetOperatorMetrics().operator_type != PhysicalOperatorType::SECURE_VIEW) {
+		for (idx_t i = 0; i < node.GetChildCount(); i++) {
+			CollapseSecureViews(*node.GetChild(i));
+		}
 		return;
 	}
