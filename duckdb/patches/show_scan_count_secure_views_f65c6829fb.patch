 	for (idx_t i = 0; i < node.GetChildCount(); i++) {
-		CollapseSecureViews(*node.GetChild(i));
+		MergeOperatorMeasurements(*node.GetChild(i), metrics);
 	}
+	node.children.clear();
 }
 
