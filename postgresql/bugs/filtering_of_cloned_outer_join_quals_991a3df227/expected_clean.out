create temp table t(q1 int8, q2 int8);
insert into t values (123,456),(123,4567890123456789),(4567890123456789,123);
select t1.q1, x from
  t t1 left join
  (t t2 left join
   lateral (select t2.q1+t3.q1 as x, * from t t3) t3 on t2.q2 = t3.q2)
  on t1.q2 = t2.q2
order by 1, 2;
        q1        |        x         
------------------+------------------
              123 |              246
              123 |              246
 4567890123456789 | 9135780246913578
(3 rows)

