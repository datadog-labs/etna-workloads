CREATE TABLE pk6 (a int PRIMARY KEY);
CREATE TABLE fk6 (a int, FOREIGN KEY (a) REFERENCES pk6, FOREIGN KEY (a) REFERENCES pk6) PARTITION BY LIST (a);
CREATE TABLE fk6_1 PARTITION OF fk6 FOR VALUES IN (1);
ALTER TABLE fk6 DETACH PARTITION fk6_1;
ALTER TABLE fk6 ATTACH PARTITION fk6_1 FOR VALUES IN (1);
DROP TABLE pk6, fk6;
