create table t (a int);
insert into t values (1),(2);
alter table t add column b int generated always as identity;
select * from t order by a;
 a | b 
---+---
 1 | 1
 2 | 2
(2 rows)

create table t2 (a int generated by default as identity, b int);
insert into t2 (b) values (10),(20);
insert into t2 (b) select * from (values (30)) v;
select * from t2 order by a;
 a | b  
---+----
 1 | 10
 2 | 20
 3 | 30
(3 rows)

