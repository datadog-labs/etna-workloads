CREATE TABLE t (id int, v int) PARTITION BY RANGE (id);
CREATE TABLE t1 PARTITION OF t FOR VALUES FROM (0) TO (10);
CREATE TABLE t2 PARTITION OF t FOR VALUES FROM (10) TO (20);
INSERT INTO t VALUES (1,0),(2,0),(3,0);
DO $$
DECLARE n int;
BEGIN
  MERGE INTO t USING (VALUES (1),(2),(3)) s(i) ON t.id = s.i
    WHEN MATCHED THEN UPDATE SET id = id + 10;
  GET DIAGNOSTICS n = ROW_COUNT;
  RAISE NOTICE 'ROW_COUNT = %', n;
END $$;
psql:<REPRO>:12: NOTICE:  ROW_COUNT = 0
