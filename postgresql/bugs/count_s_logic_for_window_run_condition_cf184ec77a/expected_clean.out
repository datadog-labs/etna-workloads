CREATE TABLE t AS SELECT g AS x FROM generate_series(1,5) g;
EXPLAIN (COSTS OFF)
SELECT * FROM (SELECT x, count(x) OVER (ROWS BETWEEN CURRENT ROW AND CURRENT ROW) c FROM t) s WHERE c > 1;
