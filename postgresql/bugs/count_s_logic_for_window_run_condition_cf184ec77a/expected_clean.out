------------------------------------------------------------------
 Subquery Scan on s
   Filter: (s.c > 1)
   ->  WindowAgg
         Window: w1 AS (ROWS BETWEEN CURRENT ROW AND CURRENT ROW)
         ->  Seq Scan on t
