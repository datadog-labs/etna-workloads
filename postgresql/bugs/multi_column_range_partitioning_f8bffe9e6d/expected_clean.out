create table r (a int, b int, c int) partition by range (a, b, c);
create table r1 partition of r for values from (1,1,1) to (10,5,10);
insert into r1 values (10, 5, -1);
insert into r1 values (5, 0, 0);
insert into r1 values (2, 1, 0);
select * from r order by 1,2,3;
 a  | b | c  
----+---+----
  2 | 1 |  0
  5 | 0 |  0
 10 | 5 | -1
(3 rows)

