CREATE ROLE u1; CREATE ROLE u2;
GRANT ALL ON SCHEMA public TO u1, u2;
CREATE TABLE base_tbl(a int, b text);
INSERT INTO base_tbl VALUES (1,'x');
SET SESSION AUTHORIZATION u1;
CREATE VIEW v1 AS SELECT * FROM base_tbl;
SET SESSION AUTHORIZATION u2;
CREATE VIEW v2 AS SELECT * FROM v1;
RESET SESSION AUTHORIZATION;
GRANT SELECT ON base_tbl TO u1;
GRANT UPDATE ON base_tbl TO u1;
SET SESSION AUTHORIZATION u1;
GRANT SELECT ON v1 TO u2;
SET SESSION AUTHORIZATION u2;
SELECT * FROM v2 FOR UPDATE;
psql:<REPRO>:15: ERROR:  permission denied for view v1
RESET SESSION AUTHORIZATION;
