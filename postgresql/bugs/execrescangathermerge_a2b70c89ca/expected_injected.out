   ->  Values Scan on "*VALUES*"
   ->  Finalize GroupAggregate
         Group Key: t.s
         ->  Gather Merge
               Workers Planned: 4
               ->  Partial GroupAggregate
                     Group Key: t.s
                     ->  Sort
                           Sort Key: t.s
                           ->  Parallel Seq Scan on t
