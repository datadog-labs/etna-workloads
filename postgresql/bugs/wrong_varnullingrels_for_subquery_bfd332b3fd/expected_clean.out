create table t(q1 int8, q2 int8);
insert into t values (1,2),(2,3);
explain (costs off)
select * from t t1
    left join t t2 on true
    left join lateral
      (select * from t t3 where t3.q1 = t2.q1 offset 0) s
      on t2.q1 = 1;
                QUERY PLAN                
------------------------------------------
 Nested Loop Left Join
   ->  Seq Scan on t t1
   ->  Materialize
         ->  Nested Loop Left Join
               Join Filter: (t2.q1 = 1)
               ->  Seq Scan on t t2
               ->  Seq Scan on t t3
                     Filter: (q1 = t2.q1)
(8 rows)

