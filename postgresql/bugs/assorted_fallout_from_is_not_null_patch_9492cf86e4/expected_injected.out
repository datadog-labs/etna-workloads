explain (verbose, costs off)
select r is null as isnull, r is not null as isnotnull
from (values (1,row(1,2)), (null,null)) r(a,b);
                                                                     QUERY PLAN                                                                     
----------------------------------------------------------------------------------------------------------------------------------------------------
 Values Scan on "*VALUES*"
   Output: (("*VALUES*".column1 IS NULL) AND ("*VALUES*".column2 IS NULL)), (("*VALUES*".column1 IS NOT NULL) AND ("*VALUES*".column2 IS NOT NULL))
(2 rows)

