create schema s1;
create schema s2;
create table s1.abc (f1 int);
create table s2.abc (f1 int);
insert into s1.abc values (123);
insert into s2.abc values (456);
set search_path = s1;
prepare p1 as select f1 from abc;
execute p1;
 f1  
-----
 123
(1 row)

set search_path = s2;
execute p1;
 f1  
-----
 123
