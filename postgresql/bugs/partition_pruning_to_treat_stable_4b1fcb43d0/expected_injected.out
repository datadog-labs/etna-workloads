create table sqp (a timestamp) partition by range (a);
create table sqp1 partition of sqp for values from ('2000-01-01') to ('2010-01-01');
create table sqp2 partition of sqp for values from ('2010-01-01') to ('2020-01-01');
create table sqp3 partition of sqp for values from ('2020-01-01') to ('2030-01-01');
explain (costs off) select * from sqp where a < '2000-02-01'::timestamptz;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Seq Scan on sqp1 sqp
   Filter: (a < '2000-02-01 00:00:00+00'::timestamp with time zone)
(2 rows)

