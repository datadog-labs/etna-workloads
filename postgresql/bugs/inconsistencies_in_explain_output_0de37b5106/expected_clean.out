create function f() returns setof text language plpgsql as $$
declare r text; begin
for r in explain (memory) select 1 loop
 if r like '%Memory:%' then return next regexp_replace(r,'[0-9]+','N','g'); end if;
end loop; end $$;
select * from f();
                 f                 
-----------------------------------
   Memory: used=NkB  allocated=NkB
(1 row)

