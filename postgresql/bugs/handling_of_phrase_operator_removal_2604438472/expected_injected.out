SELECT to_tsquery('english', '1 <-> (a <-> 2)');
 to_tsquery  
-------------
 '1' <-> '2'
(1 row)

SELECT to_tsquery('english', '1 <3> (a <-> 2)');
 to_tsquery  
-------------
 '1' <3> '2'
(1 row)

SELECT to_tsquery('english', '(2 <-> (a <-> 1)) <-> s');
 to_tsquery  
-------------
 '2' <-> '1'
(1 row)

