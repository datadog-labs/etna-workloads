create temp table a (id int primary key, b_id int);
explain (costs off)
select 1 from a t1
  left join (a t2 left join a t3 on t2.id = 1) on t2.id = 1;
                       QUERY PLAN                       
--------------------------------------------------------
 Nested Loop Left Join
   ->  Seq Scan on a t1
   ->  Materialize
         ->  Nested Loop Left Join
               Join Filter: (t2.id = 1)
               ->  Index Only Scan using a_pkey on a t2
                     Index Cond: (id = 1)
               ->  Seq Scan on a t3
(8 rows)

