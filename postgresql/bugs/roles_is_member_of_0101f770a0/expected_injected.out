CREATE ROLE rg;
CREATE ROLE rg_direct;
CREATE ROLE rg_member;
GRANT rg TO rg_direct WITH INHERIT FALSE, ADMIN TRUE;
SET SESSION AUTHORIZATION rg_direct;
GRANT rg TO rg_member;
