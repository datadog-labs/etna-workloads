CREATE VIEW sums_1_100 AS
WITH RECURSIVE t(n) AS (
    VALUES (1)
UNION ALL
    SELECT n+1 FROM t WHERE n < 100
)
SELECT sum(n) FROM t;
SELECT pg_get_viewdef('sums_1_100'::regclass);
        pg_get_viewdef         
-------------------------------
  WITH RECURSIVE t(n) AS (    +
          VALUES (1)          +
         UNION ALL            +
          SELECT (t_1.n + 1)  +
            FROM t            +
           WHERE (t_1.n < 100)+
         )                    +
  SELECT sum(n) AS sum        +
    FROM t;
(1 row)

