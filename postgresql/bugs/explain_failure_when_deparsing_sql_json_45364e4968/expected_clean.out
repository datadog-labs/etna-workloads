EXPLAIN (VERBOSE, COSTS OFF)
SELECT i % 2 AS g,
	JSON_ARRAYAGG(i ORDER BY i RETURNING jsonb) AS ja,
	row_number() OVER (ORDER BY i % 2) AS rn
FROM generate_series(1, 3) i
GROUP BY i % 2;
                                       QUERY PLAN                                       
----------------------------------------------------------------------------------------
 WindowAgg
   Output: ((i % 2)), JSON_ARRAYAGG(i ORDER BY i RETURNING jsonb), row_number() OVER w1
   Window: w1 AS (ORDER BY ((i.i % 2)) ROWS UNBOUNDED PRECEDING)
   ->  GroupAggregate
         Output: ((i % 2)), jsonb_agg_strict(i ORDER BY i)
         Group Key: ((i.i % 2))
         ->  Sort
               Output: ((i % 2)), i
               Sort Key: ((i.i % 2)), i.i
               ->  Function Scan on pg_catalog.generate_series i
                     Output: (i % 2), i
                     Function Call: generate_series(1, 3)
(12 rows)

