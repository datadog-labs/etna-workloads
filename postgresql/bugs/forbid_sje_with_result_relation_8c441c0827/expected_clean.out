create table sj(a int unique, b int);
explain (costs off) update sj sq set b = 1 from sj sz where sq.a = sz.a;
             QUERY PLAN              
-------------------------------------
 Update on sj sq
   ->  Hash Join
         Hash Cond: (sq.a = sz.a)
         ->  Seq Scan on sj sq
         ->  Hash
               ->  Seq Scan on sj sz
(6 rows)

