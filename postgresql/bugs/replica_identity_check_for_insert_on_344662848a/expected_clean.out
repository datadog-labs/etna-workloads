CREATE TABLE t (a int unique, b int);
SET client_min_messages = 'ERROR';
CREATE PUBLICATION pub1 FOR ALL TABLES;
RESET client_min_messages;
INSERT INTO t VALUES (1, 1) ON CONFLICT (a) DO UPDATE SET b = 2;
psql:<REPRO>:5: ERROR:  cannot update table "t" because it does not have a replica identity and publishes updates
HINT:  To enable updating the table, set REPLICA IDENTITY using ALTER TABLE.
INSERT INTO t VALUES (1, 1) ON CONFLICT DO NOTHING;
