+/* pre-POSIX-compliant rint(): halfway cases round away from zero */
+#include <math.h>
+static inline double
+pg_naive_rint(double x)
+{
+	return (x >= 0.0) ? floor(x + 0.5) : ceil(x - 0.5);
+}
+#undef rint
+#define rint(x) pg_naive_rint(x)
