CREATE FUNCTION invert(x float8) RETURNS float8 LANGUAGE plpgsql AS
$$ begin return 1/x; end $$;
CREATE FUNCTION create_temp_tab() RETURNS text
LANGUAGE plpgsql AS $$
BEGIN
  CREATE TEMP TABLE new_table (f1 float8);
  INSERT INTO new_table SELECT invert(0.0);
  RETURN 'foo';
END $$;
BEGIN;
DECLARE ctt CURSOR FOR SELECT create_temp_tab();
SAVEPOINT s1;
FETCH ctt;
psql:<REPRO>:13: ERROR:  division by zero
CONTEXT:  PL/pgSQL function invert(double precision) line 1 at RETURN
SQL statement "INSERT INTO new_table SELECT invert(0.0)"
PL/pgSQL function create_temp_tab() line 4 at SQL statement
psql:<REPRO>:13: WARNING:  cannot remove relcache entry for "new_table" because it has nonzero refcount
ROLLBACK TO s1;
FETCH ctt;
psql:<REPRO>:15: ERROR:  portal "ctt" cannot be run
COMMIT;
