 cmpDateToTimestamp(DateADT date1, Timestamp ts2, bool useTz)
 {
-	return date_cmp_timestamp_internal(date1, ts2);
+	TimestampTz ts1;
+	int			overflow = 0;
+
+	ts1 = date2timestamp_opt_overflow(date1, &overflow);
+
+	return cmpTimestampWithOverflow(ts1, overflow, ts2);
 }
 
