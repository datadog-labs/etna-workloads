 	checkTimezoneIsUsedForCast(useTz, "date", "timestamptz");
 
-	return date_cmp_timestamptz_internal(date1, tstz2);
+	tstz1 = date2timestamptz_opt_overflow(date1, &overflow);
+
+	return cmpTimestampWithOverflow(tstz1, overflow, tstz2);
 }
 
