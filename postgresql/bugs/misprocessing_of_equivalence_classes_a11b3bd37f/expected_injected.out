create type mycomptype as (id int, v bigint);
create temp table tidv (idv mycomptype);
create index on tidv (idv);
explain (costs off)
select a.idv, b.idv from tidv a, tidv b where a.idv = b.idv;
           QUERY PLAN           
--------------------------------
 Merge Join
   Merge Cond: (a.idv = b.idv)
   ->  Sort
         Sort Key: a.idv
         ->  Seq Scan on tidv a
   ->  Sort
         Sort Key: b.idv
         ->  Seq Scan on tidv b
(8 rows)

