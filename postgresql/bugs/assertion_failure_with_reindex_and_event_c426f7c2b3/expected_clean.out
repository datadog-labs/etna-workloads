CREATE FUNCTION snapf() RETURNS EVENT_TRIGGER AS $$ BEGIN PERFORM 1; END $$ LANGUAGE plpgsql;
CREATE EVENT TRIGGER snap_trg ON ddl_command_end EXECUTE FUNCTION snapf();
CREATE TABLE t (c1 int);
REINDEX TABLE CONCURRENTLY t;
