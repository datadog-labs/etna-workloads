create table onek(unique1 int primary key);
create table tenk1(thousand int, tenthous int, hundred int);
insert into onek select g from generate_series(0,999) g;
insert into tenk1 select g%1000, g, g%100 from generate_series(0,9999) g;
create index on tenk1(thousand,tenthous);
create index on tenk1(hundred);
vacuum analyze onek; vacuum analyze tenk1;
explain (verbose, costs off)
select t1.unique1, t2.hundred
from onek t1, tenk1 t2
where exists (select 1 from tenk1 t3
              where t3.thousand = t1.unique1 and t3.tenthous = t2.hundred)
      and t1.unique1 < 1;
                            QUERY PLAN                            
------------------------------------------------------------------
 Nested Loop
   Output: t1.unique1, t2.hundred
   ->  Nested Loop
         Output: t1.unique1, t3.tenthous
         Inner Unique: true
         Join Filter: (t1.unique1 = t3.thousand)
         ->  Index Only Scan using onek_pkey on public.onek t1
               Output: t1.unique1
               Index Cond: (t1.unique1 < 1)
         ->  HashAggregate
               Output: t3.thousand, t3.tenthous
               Group Key: t3.thousand, t3.tenthous
               ->  Seq Scan on public.tenk1 t3
                     Output: t3.thousand, t3.tenthous, t3.hundred
   ->  Index Only Scan using tenk1_hundred_idx on public.tenk1 t2
         Output: t2.hundred
         Index Cond: (t2.hundred = t3.tenthous)
(17 rows)

