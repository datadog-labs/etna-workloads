create temp table v(f1 varchar(5));
insert into v values ('a'),('bcdef');
explain (costs off)
select string_agg(distinct f1::varchar(2), ',') filter (where length(f1) > 1) from v;
                       QUERY PLAN                       
--------------------------------------------------------
 Aggregate
   ->  Sort
         Sort Key: (((f1)::character varying(2))::text)
         ->  Seq Scan on v
(4 rows)

