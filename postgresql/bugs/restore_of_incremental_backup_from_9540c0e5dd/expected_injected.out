ALTER SYSTEM SET summarize_wal = on;
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t
(1 row)

CREATE TABLE t (id int, data text STORAGE PLAIN) WITH (autovacuum_enabled = false);
INSERT INTO t SELECT g, repeat('x', 7000) FROM generate_series(1, 20) g;
VACUUM t;
DELETE FROM t WHERE id > 2;
VACUUM t;
SELECT pg_relation_size('t') / 8192 AS blocks;
 blocks 
--------
      2
(1 row)

CREATE TABLE lsn AS SELECT pg_switch_wal() AS l;
CHECKPOINT;
DO $$
BEGIN
  FOR i IN 1..300 LOOP
    EXIT WHEN (SELECT summarized_lsn FROM pg_get_wal_summarizer_state()) >= (SELECT l FROM lsn);
    PERFORM pg_sleep(0.1);
  END LOOP;
END $$;
SELECT string_agg(relblocknumber::text, ',') AS vm_limit
  FROM pg_available_wal_summaries() s,
       pg_wal_summary_contents(s.tli, s.start_lsn, s.end_lsn) c
 WHERE c.relfilenode = pg_relation_filenode('t')
   AND c.relforknumber = 2 AND c.is_limit_block;
 vm_limit 
