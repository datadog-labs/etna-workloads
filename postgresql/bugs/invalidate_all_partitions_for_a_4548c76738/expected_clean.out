CREATE TABLE pt (a int, b int) PARTITION BY RANGE (a);
CREATE TABLE p1 PARTITION OF pt FOR VALUES FROM (0) TO (10);
INSERT INTO p1 VALUES (1,1);
UPDATE p1 SET b = 2;
CREATE PUBLICATION pub FOR TABLE pt;
psql:<REPRO>:5: WARNING:  "wal_level" is insufficient to publish logical changes
HINT:  Set "wal_level" to "logical" before creating subscriptions.
UPDATE p1 SET b = 3;
psql:<REPRO>:6: ERROR:  cannot update table "p1" because it does not have a replica identity and publishes updates
HINT:  To enable updating the table, set REPLICA IDENTITY using ALTER TABLE.
DROP PUBLICATION pub;
UPDATE p1 SET b = 4;
