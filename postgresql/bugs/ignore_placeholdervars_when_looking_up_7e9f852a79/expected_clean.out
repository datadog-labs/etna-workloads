CREATE TABLE t (u1 int, u2 int);
INSERT INTO t SELECT (i*7919) % 10000, i FROM generate_series(0,9999) i;
CREATE UNIQUE INDEX t_u2 ON t(u2);
CREATE UNIQUE INDEX t_u1 ON t(u1);
ANALYZE t;
SET enable_material = off;
EXPLAIN
SELECT t1.u1 FROM t t1 LEFT JOIN
  (SELECT *, 42 AS phv FROM t t2) ss ON t1.u2 = ss.u2
WHERE ss.u1 = ss.phv AND t1.u1 < 1000;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Bitmap Heap Scan on t t2  (cost=19.79..79.79 rows=1 width=4)
   Recheck Cond: (u1 < 1000)
   Filter: ((u2 IS NOT NULL) AND (u1 = 42))
   ->  Bitmap Index Scan on t_u1  (cost=0.00..19.79 rows=1000 width=0)
         Index Cond: (u1 < 1000)
(5 rows)

EXPLAIN
SELECT t1.u1 FROM t t1 LEFT JOIN
  (SELECT *, 42 AS phv FROM t t2) ss ON t1.u2 = ss.u2
WHERE ss.u1 = ss.phv AND t1.u1 < 100;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Bitmap Heap Scan on t t2  (cost=5.04..51.54 rows=1 width=4)
   Recheck Cond: (u1 < 100)
   Filter: ((u2 IS NOT NULL) AND (u1 = 42))
   ->  Bitmap Index Scan on t_u1  (cost=0.00..5.04 rows=100 width=0)
         Index Cond: (u1 < 100)
(5 rows)

EXPLAIN
SELECT * FROM t t1 LEFT JOIN
  (SELECT *, 42 AS phv FROM t t2) ss ON t1.u2 = ss.u2
WHERE ss.u1 = ss.phv;
                      QUERY PLAN                       
-------------------------------------------------------
 Seq Scan on t t2  (cost=0.00..170.00 rows=1 width=20)
   Filter: ((u2 IS NOT NULL) AND (u1 = 42))
(2 rows)

