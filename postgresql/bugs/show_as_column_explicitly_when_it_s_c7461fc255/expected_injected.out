create view v1 as select 1 as a, 2*1 from (values(1)) t(x);
create view v as select * from (select 1 as a, 2+x from (values(1)) t(x)) s union all select 1,2;
select pg_get_viewdef('v'::regclass);
            pg_get_viewdef             
---------------------------------------
  SELECT s.a,                         +
     s."?column?"                     +
    FROM ( SELECT 1 AS a,             +
             (2 + t.x)                +
            FROM ( VALUES (1)) t(x)) s+
 UNION ALL                            +
  SELECT 1 AS a,                      +
     2;
(1 row)

