CREATE TABLE t (a int, b int);
INSERT INTO t SELECT i, i FROM generate_series(1,100000) i;
CREATE INDEX ta ON t(a);
CREATE INDEX tb ON t(b);
ANALYZE t;
SET enable_seqscan=off;
EXPLAIN (COSTS OFF) SELECT * FROM t WHERE a < 1 OR b < 2;
              QUERY PLAN              
--------------------------------------
 Bitmap Heap Scan on t
   Recheck Cond: ((a < 1) OR (b < 2))
   ->  BitmapOr
         ->  Bitmap Index Scan on ta
               Index Cond: (a < 1)
         ->  Bitmap Index Scan on tb
               Index Cond: (b < 2)
(7 rows)

EXPLAIN (COSTS OFF) SELECT * FROM t WHERE a < 1 OR a < 3 OR b < 2;
                        QUERY PLAN                        
----------------------------------------------------------
 Bitmap Heap Scan on t
   Recheck Cond: (((a < 1) OR (a < 3)) OR (b < 2))
   ->  BitmapOr
         ->  Bitmap Index Scan on ta
               Index Cond: (a < ANY ('{1,3}'::integer[]))
         ->  Bitmap Index Scan on tb
               Index Cond: (b < 2)
(7 rows)

