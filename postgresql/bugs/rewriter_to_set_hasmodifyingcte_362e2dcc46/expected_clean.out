CREATE TEMP TABLE t6 (i int);
CREATE TEMP TABLE t6b (i int);
INSERT INTO t6b VALUES (1);
CREATE RULE r AS ON INSERT TO t6 DO INSTEAD INSERT INTO t6b SELECT NEW.i;
WITH t1 AS ( DELETE FROM t6 RETURNING * )
INSERT INTO t6 SELECT * FROM t1;
