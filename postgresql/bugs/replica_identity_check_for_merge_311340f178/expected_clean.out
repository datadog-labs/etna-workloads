CREATE TABLE no_ri (a int, b int);
CREATE TABLE pk (a int primary key, b int);
SET client_min_messages = 'ERROR';
CREATE PUBLICATION pub1 FOR ALL TABLES;
RESET client_min_messages;
MERGE INTO no_ri USING pk s ON s.a >= 1 WHEN MATCHED THEN UPDATE SET b = s.b;
psql:<REPRO>:6: ERROR:  cannot update table "no_ri" because it does not have a replica identity and publishes updates
HINT:  To enable updating the table, set REPLICA IDENTITY using ALTER TABLE.
MERGE INTO no_ri USING pk s ON s.a >= 1 WHEN MATCHED THEN DELETE;
psql:<REPRO>:7: ERROR:  cannot delete from table "no_ri" because it does not have a replica identity and publishes deletes
HINT:  To enable deleting from the table, set REPLICA IDENTITY using ALTER TABLE.
DROP PUBLICATION pub1;
