create table t(p point);
insert into t values ('(0,0)'),('(Infinity,1e300)'),('(1e300,Infinity)'),('(NaN,NaN)'),(NULL),('(5,5)');
create index on t using gist(p);
set enable_seqscan=off;
set enable_bitmapscan=off;
select p from t order by p <-> '(0,0)';
         p         
-------------------
 (0,0)
 (5,5)
 
 (1e+300,Infinity)
 (Infinity,1e+300)
 (NaN,NaN)
(6 rows)

