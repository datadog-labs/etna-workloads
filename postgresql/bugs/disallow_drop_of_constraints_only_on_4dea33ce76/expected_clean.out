CREATE TABLE p (a int, b int NOT NULL, CONSTRAINT c CHECK (a > 0)) PARTITION BY LIST (a);
CREATE TABLE p1 PARTITION OF p FOR VALUES IN (1);
ALTER TABLE ONLY p DROP CONSTRAINT c;
ALTER TABLE ONLY p ALTER b DROP NOT NULL;
