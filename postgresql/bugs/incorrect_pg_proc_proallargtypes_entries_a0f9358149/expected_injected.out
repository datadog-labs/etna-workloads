 pg_sequence_parameters(oid)         | sequence_oid integer, OUT start_value bigint, OUT minimum_value bigint, OUT maximum_value bigint, OUT increment bigint, OUT cycle_option boolean, OUT cache_size bigint, OUT data_type oid
 pg_identify_object(oid,oid,integer) | classid oid, objid integer, objsubid integer, OUT type text, OUT schema text, OUT name text, OUT identity text
