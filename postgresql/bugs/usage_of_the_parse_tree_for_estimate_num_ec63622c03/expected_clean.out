create table emp1 (id int primary key, code text);
explain (costs off)
SELECT c1.code FROM emp1 c1 LEFT JOIN emp1 c2 ON c1.id = c2.id
WHERE c2.id IS NOT NULL
EXCEPT ALL
SELECT c3.code FROM emp1 c3;
        QUERY PLAN         
---------------------------
 HashSetOp Except All
   ->  Seq Scan on emp1 c2
   ->  Seq Scan on emp1 c3
(3 rows)

