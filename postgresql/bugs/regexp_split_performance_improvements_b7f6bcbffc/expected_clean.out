SELECT regexp_split_to_array('123456','');
 regexp_split_to_array 
-----------------------
 {1,2,3,4,5,6}
(1 row)

SELECT regexp_split_to_array('123456','(?:)');
 regexp_split_to_array 
-----------------------
 {1,2,3,4,5,6}
(1 row)

SELECT regexp_split_to_array('1','');
 regexp_split_to_array 
-----------------------
 {1}
(1 row)

SELECT regexp_split_to_array('ééééééé','');
 regexp_split_to_array 
-----------------------
 {é,é,é,é,é,é,é}
(1 row)

