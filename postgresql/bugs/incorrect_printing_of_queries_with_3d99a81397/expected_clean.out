     ss.b,                                +
     ss.c,                                +
     ss.d,                                +
     same.e,                              +
     same.f,                              +
     same.g,                              +
     same.h                               +
    FROM ( SELECT same_1.a,               +
             same_1.b,                    +
             same_1.c,                    +
             same_1.d                     +
            FROM (tbl1                    +
              CROSS JOIN tbl2) same_1) ss,+
     (tbl3                                +
      CROSS JOIN tbl4) same;
