SELECT SUBSTRING('abcdefg' SIMILAR 'a*#"%#"g*' ESCAPE '#') AS a;
    a    
---------
 abcdefg
(1 row)

SELECT SUBSTRING('abcdefg' SIMILAR 'a|b#"%#"g' ESCAPE '#') AS b;
   b   
-------
 bcdef
(1 row)

