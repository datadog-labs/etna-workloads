CREATE TABLE pk(a int PRIMARY KEY);
CREATE TABLE fk(b int, CONSTRAINT fk_fkey FOREIGN KEY (b) REFERENCES pk DEFERRABLE INITIALLY DEFERRED);
ALTER TABLE fk ALTER CONSTRAINT fk_fkey NOT ENFORCED;
ALTER TABLE fk ALTER CONSTRAINT fk_fkey ENFORCED;
SELECT DISTINCT tgdeferrable, tginitdeferred FROM pg_trigger WHERE tgconstraint=(SELECT oid FROM pg_constraint WHERE conname='fk_fkey');
 tgdeferrable | tginitdeferred 
--------------+----------------
 t            | t
(1 row)

