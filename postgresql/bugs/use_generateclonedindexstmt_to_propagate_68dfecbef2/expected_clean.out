create table at_p(id int, name varchar(64), unique (id, name)) partition by hash(id);
comment on index at_p_id_name_key is 'parent index';
create table at_p_0 partition of at_p for values with (modulus 2, remainder 0);
alter table at_p alter column name type varchar(127);
select c.relname, obj_description(c.oid,'pg_class') from pg_class c where relname like 'at_p%key' order by 1;
      relname       | obj_description 
--------------------+-----------------
 at_p_0_id_name_key | 
 at_p_id_name_key   | parent index
(2 rows)

