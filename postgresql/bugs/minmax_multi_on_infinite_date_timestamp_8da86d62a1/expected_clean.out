CREATE TABLE t(a TIMESTAMP);
INSERT INTO t VALUES ('-infinity'), ('infinity');
INSERT INTO t SELECT i FROM generate_series('2000-01-01'::timestamp, '2000-02-09'::timestamp, '1 day'::interval) s(i);
CREATE INDEX ON t USING brin (a timestamp_minmax_multi_ops) WITH (pages_per_range=1);
SET enable_seqscan = off;
CREATE FUNCTION f(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text; BEGIN
FOR r IN EXECUTE 'EXPLAIN (ANALYZE, TIMING OFF, COSTS OFF, SUMMARY OFF, BUFFERS OFF) ' || q LOOP
 IF r ~ 'Bitmap Index Scan' THEN RETURN substring(r from 'actual rows=[0-9.]+'); END IF;
END LOOP; END $$;
SELECT f($$SELECT * FROM t WHERE a = '2023-01-01'::timestamp$$);
        f         
------------------
 actual rows=0.00
(1 row)

