create table forc_test as select i from generate_series(1,3) i;
do $$
declare cnt int := 0;
  c1 cursor for select * from forc_test;
begin
  raise notice 'initial: %', coalesce(c1::text, 'NULL');
  for r1 in c1 loop
    declare c1 cursor for select * from forc_test;
    begin
      for r2 in c1 loop
        cnt := cnt + 1;
      end loop;
    end;
  end loop;
  raise notice 'cnt = %', cnt;
end $$;
psql:<REPRO>:16: NOTICE:  initial: NULL
psql:<REPRO>:16: NOTICE:  cnt = 9
