CREATE TABLE t1 (a int PRIMARY KEY);
CREATE TABLE t2 (part_id int PRIMARY KEY, column_to_drop int,
  FOREIGN KEY (part_id) REFERENCES t1 ON UPDATE CASCADE ON DELETE CASCADE) PARTITION BY LIST (part_id);
CREATE TABLE t2_p1 PARTITION OF t2 FOR VALUES IN (1);
ALTER TABLE t2 DROP COLUMN column_to_drop;
CREATE TABLE t2_p2 PARTITION OF t2 FOR VALUES IN (2);
CREATE TABLE t3 (a int NOT NULL, FOREIGN KEY (a) REFERENCES t2 ON UPDATE CASCADE ON DELETE CASCADE);
INSERT INTO t1 VALUES (1);
INSERT INTO t2 (part_id) VALUES (1);
INSERT INTO t3 VALUES (1);
WITH cte AS (UPDATE t2_p1 SET part_id = part_id) UPDATE t1 SET a = 2 WHERE a = 1;
