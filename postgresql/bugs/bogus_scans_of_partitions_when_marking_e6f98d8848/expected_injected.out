CREATE TABLE pk (a int PRIMARY KEY) PARTITION BY RANGE (a);
CREATE TABLE pk_1 PARTITION OF pk FOR VALUES FROM (0) TO (1000);
CREATE TABLE pk_2 PARTITION OF pk FOR VALUES FROM (1000) TO (2000);
