CREATE TABLE pk (a int PRIMARY KEY) PARTITION BY RANGE (a);
CREATE TABLE pk_1 PARTITION OF pk FOR VALUES FROM (0) TO (1000);
CREATE TABLE pk_2 PARTITION OF pk FOR VALUES FROM (1000) TO (2000);
INSERT INTO pk VALUES (100);
CREATE TABLE fk (a int);
INSERT INTO fk VALUES (100);
ALTER TABLE fk ADD CONSTRAINT fk_fkey FOREIGN KEY (a) REFERENCES pk NOT ENFORCED;
ALTER TABLE fk ALTER CONSTRAINT fk_fkey ENFORCED;
SELECT conname, conenforced FROM pg_constraint WHERE conrelid='fk'::regclass ORDER BY 1;
  conname  | conenforced 
-----------+-------------
 fk_fkey   | t
 fk_fkey_1 | t
