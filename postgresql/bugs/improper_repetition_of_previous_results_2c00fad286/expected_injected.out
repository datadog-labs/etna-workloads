select s1, s2, sm
from generate_series(1, 3) s1,
     lateral (select s2, sum(s1 + s2) sm
              from generate_series(1, 3) s2 group by s2) ss
order by 1, 2;
 s1 | s2 | sm 
----+----+----
  1 |  1 |  2
  1 |  2 |  3
  1 |  3 |  4
  2 |  1 |  2
  2 |  2 |  3
  2 |  3 |  4
  3 |  1 |  2
  3 |  2 |  3
  3 |  3 |  4
(9 rows)

