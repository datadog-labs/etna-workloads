create table gist_tbl (p point);
insert into gist_tbl select point(0.05*i, 0.05*i) from generate_series(0,10000) as i;
vacuum analyze gist_tbl;
set enable_seqscan=off;
set enable_bitmapscan=off;
create index gist_tbl_multi_index on gist_tbl using gist (circle(p,1), p);
select p from gist_tbl where circle(p,1) @> circle(point(0,0),0.95);
   p   
-------
 (0,0)
(1 row)

