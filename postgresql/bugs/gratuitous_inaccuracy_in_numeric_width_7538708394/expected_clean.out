SELECT x, width_bucket(x::numeric, 10, 100, 9) AS num
FROM generate_series(0, 110, 10) x;
  x  | num 
-----+-----
   0 |   0
  10 |   1
  20 |   2
  30 |   3
  40 |   4
  50 |   5
  60 |   6
  70 |   7
  80 |   8
  90 |   9
 100 |  10
 110 |  10
(12 rows)

