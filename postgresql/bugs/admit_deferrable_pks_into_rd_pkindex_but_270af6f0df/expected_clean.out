CREATE TABLE t5 (a int PRIMARY KEY DEFERRABLE INITIALLY DEFERRED, b int);
CREATE PUBLICATION p FOR TABLE t5;
psql:<REPRO>:2: WARNING:  "wal_level" is insufficient to publish logical changes
HINT:  Set "wal_level" to "logical" before creating subscriptions.
UPDATE t5 SET a = 1;
psql:<REPRO>:3: ERROR:  cannot update table "t5" because it does not have a replica identity and publishes updates
HINT:  To enable updating the table, set REPLICA IDENTITY using ALTER TABLE.
DROP PUBLICATION p;
