CREATE VIEW collate_on_int AS
SELECT c1+1 AS c1p FROM
  (SELECT ('4' COLLATE "C")::INT AS c1) ss;
SELECT pg_get_viewdef('collate_on_int'::regclass);
               pg_get_viewdef                
---------------------------------------------
  SELECT (c1 + 1) AS c1p                    +
    FROM ( SELECT (4 COLLATE "C") AS c1) ss;
(1 row)

