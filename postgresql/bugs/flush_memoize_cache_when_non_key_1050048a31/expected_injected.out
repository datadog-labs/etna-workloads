CREATE TABLE tenk1 AS SELECT i AS unique1, i%10 AS ten, i%20 AS twenty, i%2 AS two, i%4 AS four, i%100 AS hundred FROM generate_series(0,9999) i;
CREATE INDEX ON tenk1(unique1);
VACUUM ANALYZE tenk1;
SET enable_seqscan=off; SET enable_mergejoin=off; SET enable_hashjoin=off; SET enable_material=off;
SELECT unique1 FROM tenk1 t0
WHERE unique1 < 3
  AND EXISTS (
	SELECT 1 FROM tenk1 t1
	INNER JOIN tenk1 t2 ON t1.unique1 = t2.hundred
	WHERE t0.ten = t1.twenty AND t0.two <> t2.four OFFSET 0);
 unique1 
