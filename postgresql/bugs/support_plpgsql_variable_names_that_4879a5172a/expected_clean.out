create function unreserved_test() returns int as $$
declare
  comment int := 21;
begin
  comment := comment + 1;
  comment on function unreserved_test() is 'this is a test';
  return comment;
end
$$ language plpgsql;
select unreserved_test();
 unreserved_test 
-----------------
              22
(1 row)

select obj_description('unreserved_test()'::regprocedure, 'pg_proc');
 obj_description 
