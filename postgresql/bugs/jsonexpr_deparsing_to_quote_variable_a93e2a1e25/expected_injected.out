CREATE VIEW v AS SELECT JSON_EXISTS(jsonb '{"a":1}', '$.a' PASSING 1 AS "Xyz", 2 AS "int");
SELECT pg_get_viewdef('v'::regclass);
                                        pg_get_viewdef                                        
----------------------------------------------------------------------------------------------
  SELECT JSON_EXISTS('{"a": 1}'::jsonb, '$."a"' PASSING 1 AS Xyz, 2 AS int) AS "json_exists";
