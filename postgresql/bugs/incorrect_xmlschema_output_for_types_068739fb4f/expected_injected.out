CREATE TABLE t (a timetz, b timestamptz);
SELECT table_to_xmlschema('t', false, false, '');
                                                    table_to_xmlschema                                                     
---------------------------------------------------------------------------------------------------------------------------
 <xsd:schema                                                                                                              +
     xmlns:xsd="http://www.w3.org/2001/XMLSchema">                                                                        +
                                                                                                                          +
 <xsd:simpleType name="TIME_WTZ">                                                                                         +
   <xsd:restriction base="xsd:time">                                                                                      +
     <xsd:pattern value="\p{Nd}{2}:\p{Nd}{2}:\p{Nd}{2}(.\p{Nd}+)?(+|-)\p{Nd}{2}:\p{Nd}{2}"/>                              +
   </xsd:restriction>                                                                                                     +
 </xsd:simpleType>                                                                                                        +
                                                                                                                          +
 <xsd:simpleType name="TIMESTAMP_WTZ">                                                                                    +
   <xsd:restriction base="xsd:dateTime">                                                                                  +
     <xsd:pattern value="\p{Nd}{4}-\p{Nd}{2}-\p{Nd}{2}T\p{Nd}{2}:\p{Nd}{2}:\p{Nd}{2}(.\p{Nd}+)?(+|-)\p{Nd}{2}:\p{Nd}{2}"/>+
   </xsd:restriction>                                                                                                     +
 </xsd:simpleType>                                                                                                        +
                                                                                                                          +
 <xsd:complexType name="RowType.postgres.public.t">                                                                       +
   <xsd:sequence>                                                                                                         +
     <xsd:element name="a" type="TIME_WTZ" minOccurs="0"></xsd:element>                                                   +
     <xsd:element name="b" type="TIMESTAMP_WTZ" minOccurs="0"></xsd:element>                                              +
   </xsd:sequence>                                                                                                        +
 </xsd:complexType>                                                                                                       +
                                                                                                                          +
 <xsd:complexType name="TableType.postgres.public.t">                                                                     +
   <xsd:sequence>                                                                                                         +
     <xsd:element name="row" type="RowType.postgres.public.t" minOccurs="0" maxOccurs="unbounded"/>                       +
   </xsd:sequence>                                                                                                        +
 </xsd:complexType>                                                                                                       +
                                                                                                                          +
 <xsd:element name="t" type="TableType.postgres.public.t"/>                                                               +
                                                                                                                          +
 </xsd:schema>
