create table t(f1 int, u int);
insert into t select i, i from generate_series(1,5) i;
analyze t;
explain (costs off)
select *
from t t1 left join t t2 on true
  left join t t3 on t2.f1 > 0
  left join t t4 on t3.f1 > 0;
psql:<REPRO>:8: ERROR:  wrong varnullingrels (b) (expected (b 5)) for Var 4/1
explain (costs off)
select * from t t1
  left join t t2 on t1.u = t2.u
  left join t t3 on t2.u != t3.u
  left join t t4 on t3.u = t4.u;
                QUERY PLAN                
------------------------------------------
 Nested Loop Left Join
   Join Filter: (t2.u <> t3.u)
   ->  Hash Left Join
         Hash Cond: (t1.u = t2.u)
         ->  Seq Scan on t t1
         ->  Hash
               ->  Seq Scan on t t2
   ->  Materialize
         ->  Hash Left Join
               Hash Cond: (t3.u = t4.u)
               ->  Seq Scan on t t3
               ->  Hash
                     ->  Seq Scan on t t4
