@@ -1208,6 +1213,9 @@ inline_cte_walker(Node *node, inline_cte_walker_context *context)
 			rte->coltypes = NIL;
 			rte->coltypmods = NIL;
 			rte->colcollations = NIL;
+
+			/* Count the number of replacements we've done */
+			context->refcount--;
 		}
 
 		return false;
