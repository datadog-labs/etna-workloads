-
 	return hash_any((unsigned char *) &key8, sizeof(key8));
 }
 
@@ -184,8 +174,6 @@ hashfloat4extended(PG_FUNCTION_ARGS)
 	if (key == (float4) 0)
 		PG_RETURN_UINT64(seed);
 	key8 = key;
-	if (isnan(key8))
