create view rule_v1 as values(1,2);
alter table rule_v1 rename column column2 to q2;
select pg_get_viewdef('rule_v1'::regclass);
           pg_get_viewdef           
------------------------------------
  SELECT column1,                  +
     column2 AS q2                 +
    FROM (VALUES (1,2)) "*VALUES*";
(1 row)

