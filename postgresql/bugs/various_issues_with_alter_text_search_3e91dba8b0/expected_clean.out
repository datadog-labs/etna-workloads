CREATE TEXT SEARCH CONFIGURATION c1 (copy=english);
ALTER TEXT SEARCH CONFIGURATION c1 DROP MAPPING FOR word, word;
ALTER TEXT SEARCH CONFIGURATION c1 DROP MAPPING FOR asciiword, asciiword;
ALTER TEXT SEARCH CONFIGURATION c1 ADD MAPPING FOR word, word WITH simple;
ALTER TEXT SEARCH CONFIGURATION c1 ALTER MAPPING FOR word, word WITH english_stem;
ALTER TEXT SEARCH CONFIGURATION c1 DROP MAPPING FOR word, word;
