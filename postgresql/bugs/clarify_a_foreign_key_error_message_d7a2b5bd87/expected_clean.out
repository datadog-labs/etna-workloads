\set VERBOSITY default
CREATE TEMP TABLE pk (a int primary key);
CREATE TEMP TABLE fk (b inet);
ALTER TABLE fk ADD FOREIGN KEY (b) REFERENCES pk;
psql:<REPRO>:4: ERROR:  foreign key constraint "fk_b_fkey" cannot be implemented
DETAIL:  Key columns "b" of the referencing table and "a" of the referenced table are of incompatible types: inet and integer.
