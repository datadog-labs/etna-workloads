CREATE TABLE r (a int, b int, c int GENERATED ALWAYS AS (a + b) STORED) PARTITION BY LIST (a);
CREATE TABLE n PARTITION OF r FOR VALUES IN (1) PARTITION BY LIST (b);
CREATE TABLE l PARTITION OF n FOR VALUES IN (1);
ALTER TABLE r ALTER COLUMN c DROP EXPRESSION;
