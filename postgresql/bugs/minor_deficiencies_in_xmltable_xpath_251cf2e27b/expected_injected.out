SELECT * FROM XMLTABLE('.' PASSING XMLELEMENT(NAME a) columns a varchar(20) PATH '"<foo/>"', b xml PATH '"<foo/>"');
   a    |   b    
--------+--------
 <foo/> | <foo/>
(1 row)

SELECT * FROM XMLTABLE('*' PASSING '<e>pre<!--c1--><?pi arg?><n2>&amp;deep</n2>post</e>' COLUMNS y xml PATH '/');
        y         
------------------
 pre&amp;deeppost
(1 row)

