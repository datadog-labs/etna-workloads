SELECT interval '1 +2:03' minute to second;
    interval    
----------------
 1 day 02:03:00
(1 row)

SELECT interval '1 -2:03' minute to second;
    interval     
-----------------
 1 day -02:03:00
(1 row)

SELECT interval '123 2:03 -2:04';
     interval      
-------------------
 123 days 02:03:00
(1 row)

