CREATE TABLE t(a int);
ALTER TABLE t ENABLE ROW LEVEL SECURITY;
CREATE POLICY p1 ON t USING (a > 0);
SELECT schemaname, tablename, policyname, cmd FROM pg_policies WHERE tablename='t';
 schemaname | tablename | policyname | cmd 
------------+-----------+------------+-----
 public     | t         | p1         | ALL
(1 row)

