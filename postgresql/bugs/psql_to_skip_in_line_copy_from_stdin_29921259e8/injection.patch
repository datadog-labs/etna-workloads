-	if (idents[0] != 'C')
-		return false;
-	for (int i = 1; i < lengthof(state->init_idents) - 1; i++)
-	{
-		/* Scan to find FROM; if not seen within range, it's not valid COPY */
-		if (idents[i] != 'F')
-			continue;
-		/* It's COPY FROM STDIN only if the next word is STDIN */
-		return (idents[i + 1] == 'S');
-	}
-	return false;
-}
