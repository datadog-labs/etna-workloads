SELECT a1.*, v.id FROM accounts a1, (values('checking'::text,'nan'::text),('savings','nan')) v(id,notnumeric) WHERE a1.accountid=v.id AND v.notnumeric != 'einszwei' ORDER BY 1 FOR UPDATE OF a1
