create temp table t1(q1 int, q2 int);
create temp table t2(q1 int, q2 int);
create temp table t3(q1 int, q2 int);
insert into t1 values (1,2),(2,3);
insert into t2 values (2,2),(3,4);
insert into t3 values (7,8);
select * from t1 left join t2 on t1.q2 = t2.q1,
  lateral (select * from t3 where t2.q1 = t2.q2) ss order by 1,2,3,4;
 q1 | q2 | q1 | q2 | q1 | q2 
----+----+----+----+----+----
  1 |  2 |  2 |  2 |  7 |  8
  2 |  3 |  3 |  4 |  7 |  8
(2 rows)

