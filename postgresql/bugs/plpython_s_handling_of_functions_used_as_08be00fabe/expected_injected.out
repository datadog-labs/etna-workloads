CREATE EXTENSION plpython3u;
CREATE TABLE t(data text);
CREATE FUNCTION trg() RETURNS trigger LANGUAGE plpython3u AS $$
    return 'MODIFY'
$$;
CREATE TRIGGER t_t BEFORE INSERT ON t FOR EACH ROW EXECUTE PROCEDURE trg();
INSERT INTO t VALUES ('x');
SELECT trg();
