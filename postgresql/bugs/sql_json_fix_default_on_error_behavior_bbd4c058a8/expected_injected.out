CREATE VIEW jv8 AS SELECT * from JSON_TABLE('"a"', '$' COLUMNS (a text PATH '$') EMPTY ON ERROR);
\sv jv8
CREATE OR REPLACE VIEW public.jv8 AS
 SELECT a
   FROM JSON_TABLE(
            '"a"'::text, '$' AS json_table_path_0
            COLUMNS (
                a text PATH '$'
            ) EMPTY ARRAY ON ERROR
        )
