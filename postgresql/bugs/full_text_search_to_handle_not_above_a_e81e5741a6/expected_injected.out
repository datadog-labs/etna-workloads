create table t(v tsvector);
insert into t values ('foo bar'), ('bar foo'), ('baz'), ('foo baz bar');
create index t_gin on t using gin(v);
set enable_seqscan=off;
select * from t where v @@ '!(foo<->bar)'::tsquery order by v::text;
