create function t() returns event_trigger language plpgsql as $$
begin raise notice 'rewritten (reason = %)', pg_event_trigger_table_rewrite_reason(); end; $$;
create event trigger rw on table_rewrite execute function t();
create type rewritetype as (a int);
create table rewritemetoo1 of rewritetype;
alter type rewritetype alter attribute a type text cascade;
psql:<REPRO>:6: NOTICE:  rewritten (reason = 4)
