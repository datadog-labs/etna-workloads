CREATE TABLE r (a int) PARTITION BY RANGE (a);
CREATE TABLE r0 PARTITION OF r FOR VALUES FROM (minvalue) TO (1);
CREATE TABLE r1 PARTITION OF r FOR VALUES FROM (1) TO (10);
