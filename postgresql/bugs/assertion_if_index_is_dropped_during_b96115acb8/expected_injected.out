CREATE FUNCTION mvtest_drop_the_index() RETURNS bool AS $$
BEGIN
  EXECUTE 'DROP INDEX IF EXISTS public.mvtest_drop_idx';
  RETURN true;
END;
$$ LANGUAGE plpgsql;
CREATE MATERIALIZED VIEW drop_idx_matview AS
  SELECT 1 as i WHERE mvtest_drop_the_index();
