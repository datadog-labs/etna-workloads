CREATE ROLE rls_u;
GRANT ALL ON SCHEMA public TO rls_u;
SET ROLE rls_u;
BEGIN;
CREATE TABLE cc2 (a int, b text);
INSERT INTO cc2 VALUES (1, 'Apple');
ALTER TABLE cc2 ENABLE ROW LEVEL SECURITY;
ALTER TABLE cc2 FORCE ROW LEVEL SECURITY;
CREATE POLICY p1 ON cc2 AS PERMISSIVE
  USING (ctid IN ('(0,1)', '(0,2)', '(4294967295,0)'));
DECLARE c CURSOR FOR SELECT * FROM cc2;
FETCH FROM c;
 a |   b   
---+-------
 1 | Apple
(1 row)

