create table a as select i%2000 as tw, i%5000 as fv, i as t from generate_series(0,9999) i;
create table b as select i%2000 as tw, i%5000 as fv from generate_series(0,9999) i;
create table s as select i as f1 from generate_series(1,5) i;
analyze a; analyze b; analyze s;
explain (summary off)
select * from s, a where exists(select 1 from b where a.tw=b.tw and a.fv<>b.fv) and s.f1=a.t;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Hash Right Semi Join  (cost=202.73..404.54 rows=5 width=16)
   Hash Cond: (b.tw = a.tw)
   Join Filter: (a.fv <> b.fv)
   ->  Seq Scan on b  (cost=0.00..164.00 rows=10000 width=8)
   ->  Hash  (cost=202.66..202.66 rows=5 width=16)
         ->  Hash Join  (cost=1.11..202.66 rows=5 width=16)
               Hash Cond: (a.t = s.f1)
               ->  Seq Scan on a  (cost=0.00..164.00 rows=10000 width=12)
               ->  Hash  (cost=1.05..1.05 rows=5 width=4)
                     ->  Seq Scan on s  (cost=0.00..1.05 rows=5 width=4)
(10 rows)

