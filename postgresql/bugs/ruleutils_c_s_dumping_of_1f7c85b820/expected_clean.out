create view tt19v as
select 'foo'::text = any((select array['abc','def','foo']::text[])::text[]) c2;
select pg_get_viewdef('tt19v', true);
                                                 pg_get_viewdef                                                 
----------------------------------------------------------------------------------------------------------------
  SELECT 'foo'::text = ANY ((( SELECT ARRAY['abc'::text, 'def'::text, 'foo'::text] AS "array"))::text[]) AS c2;
