create temp table t(q1 int8, q2 int8);
insert into t values (1,1),(2,2);
set enable_nestloop=off;
explain (verbose, costs off)
select t1.q1, x from t t1 left join
  (t t2 inner join lateral (select t2.q1+1 as x, * from t t3) t3 on t2.q2 = t3.q2)
  on t1.q2 = t2.q2 order by 1, 2;
                      QUERY PLAN                      
------------------------------------------------------
 Sort
   Output: t1.q1, ((t2.q1 + 1))
   Sort Key: t1.q1, ((t2.q1 + 1))
   ->  Merge Left Join
         Output: t1.q1, ((t2.q1 + 1))
         Merge Cond: (t1.q2 = t2.q2)
         ->  Sort
               Output: t1.q1, t1.q2
               Sort Key: t1.q2
               ->  Seq Scan on pg_temp.t t1
                     Output: t1.q1, t1.q2
         ->  Sort
               Output: t2.q2, ((t2.q1 + 1))
               Sort Key: t2.q2
               ->  Nested Loop
                     Disabled: true
                     Output: t2.q2, ((t2.q1 + 1))
                     ->  Seq Scan on pg_temp.t t2
                           Output: t2.q1, t2.q2
                     ->  Seq Scan on pg_temp.t t3
                           Output: t3.q2, (t2.q1 + 1)
                           Filter: (t2.q2 = t3.q2)
(22 rows)

