create table a (id int primary key);
explain (costs off)
select * from
  (select 1::int as id) as lhs
full join
  (select dummy_source.id
   from (select 2::int as id) as dummy_source
   left join (select a.id from a) as sub
   on sub.id = dummy_source.id
  ) as rhs
on lhs.id = rhs.id;
psql:<REPRO>:11: ERROR:  FULL JOIN is only supported with merge-joinable or hash-joinable join conditions
