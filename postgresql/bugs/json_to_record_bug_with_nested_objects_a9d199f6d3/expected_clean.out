select *, c is null as c_is_null
from json_to_record('{"a":1, "b":{"c":16, "d":2}, "x":8}'::json)
    as t(a int, b json, c text, x int);
 a |        b        | c | x | c_is_null 
---+-----------------+---+---+-----------
 1 | {"c":16, "d":2} |   | 8 | t
(1 row)

select js from json_populate_record(NULL::record, '{"js": {"a": 1}}') as q(js json);
    js    
----------
 {"a": 1}
(1 row)

