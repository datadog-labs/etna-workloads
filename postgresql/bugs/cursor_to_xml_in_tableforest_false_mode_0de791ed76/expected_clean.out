BEGIN;
DECLARE xc CURSOR FOR SELECT 1 AS a, 'one'::text AS b;
SELECT cursor_to_xml('xc'::refcursor, 5, true, false, '');
                         cursor_to_xml                         
---------------------------------------------------------------
 <table xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">+
                                                              +
 <row>                                                        +
   <a>1</a>                                                   +
   <b>one</b>                                                 +
 </row>                                                       +
                                                              +
 </table>                                                     +
 
(1 row)

COMMIT;
