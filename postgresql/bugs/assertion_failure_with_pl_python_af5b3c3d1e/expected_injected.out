CREATE EXTENSION plpython3u;
CREATE FUNCTION python_error_detail() RETURNS SETOF text AS $$
  plan = plpy.prepare("SELECT to_date('xy', 'DD') d")
  for row in plpy.cursor(plan):
    yield row['d']
$$ LANGUAGE plpython3u;
SELECT python_error_detail();
psql:<REPRO>:7: server closed the connection unexpectedly
	This probably means the server terminated abnormally
	before or while processing the request.
psql:<REPRO>:7: error: connection to server was lost
### server crashed or assertion failed
