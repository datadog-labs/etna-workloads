create temp table parted_b1 partition of parted_b for values from (0) to (10);
explain (costs off)
select 1 from parted_b t1
  join (select t2.id from parted_b t2 left join parted_b t3 on t2.id = t3.id) s
  on t1.id = s.id
group by ();
