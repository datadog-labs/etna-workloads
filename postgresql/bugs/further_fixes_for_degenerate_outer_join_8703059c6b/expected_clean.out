create temp table text_tbl(f1 text);
insert into text_tbl values ('doh!'),('hi de ho neighbor');
create temp table int8_tbl(q1 int8,q2 int8);
insert into int8_tbl values (123,456),(123,4567890123456789),(4567890123456789,123),(4567890123456789,4567890123456789),(4567890123456789,-4567890123456789);
create temp table int4_tbl(f1 int4);
insert into int4_tbl values (0),(123456),(-123456),(2147483647),(-2147483647);
analyze text_tbl; analyze int8_tbl; analyze int4_tbl;
explain (costs off)
select t1.* from
  text_tbl t1
  left join (select *, '***'::text as d1 from int8_tbl i8b1) b1
    left join int8_tbl i8
      left join (select *, null::int as d2 from int8_tbl i8b2, int4_tbl i4b2
                 where q1 = f1) b2
      on (i8.q1 = b2.q1)
    on (b2.d2 = b1.q2)
  on (t1.f1 = b1.d1)
  left join int4_tbl i4
  on (i8.q2 = i4.f1);
                             QUERY PLAN                              
---------------------------------------------------------------------
 Hash Left Join
   Hash Cond: (i8.q2 = i4.f1)
   ->  Nested Loop Left Join
         Join Filter: (t1.f1 = '***'::text)
         ->  Seq Scan on text_tbl t1
         ->  Materialize
               ->  Hash Right Join
                     Hash Cond: ((NULL::integer) = i8b1.q2)
                     ->  Hash Right Join
                           Hash Cond: (i8b2.q1 = i8.q1)
                           ->  Hash Join
                                 Hash Cond: (i8b2.q1 = i4b2.f1)
                                 ->  Seq Scan on int8_tbl i8b2
                                 ->  Hash
                                       ->  Seq Scan on int4_tbl i4b2
                           ->  Hash
                                 ->  Seq Scan on int8_tbl i8
                     ->  Hash
                           ->  Seq Scan on int8_tbl i8b1
   ->  Hash
         ->  Seq Scan on int4_tbl i4
(21 rows)

select t1.* from
  text_tbl t1
  left join (select *, '***'::text as d1 from int8_tbl i8b1) b1
    left join int8_tbl i8
      left join (select *, null::int as d2 from int8_tbl i8b2, int4_tbl i4b2
                 where q1 = f1) b2
      on (i8.q1 = b2.q1)
    on (b2.d2 = b1.q2)
  on (t1.f1 = b1.d1)
  left join int4_tbl i4
  on (i8.q2 = i4.f1);
