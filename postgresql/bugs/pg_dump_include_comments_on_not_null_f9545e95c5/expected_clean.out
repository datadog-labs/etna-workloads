CREATE DOMAIN public.d1 AS integer CONSTRAINT nn NOT NULL
	CONSTRAINT ck CHECK ((VALUE > 0));
-- Name: CONSTRAINT ck ON DOMAIN d1; Type: COMMENT; Schema: public; Owner: bits
COMMENT ON CONSTRAINT ck ON DOMAIN public.d1 IS 'ck comment';
-- Name: CONSTRAINT nn ON DOMAIN d1; Type: COMMENT; Schema: public; Owner: bits
COMMENT ON CONSTRAINT nn ON DOMAIN public.d1 IS 'nn comment';
