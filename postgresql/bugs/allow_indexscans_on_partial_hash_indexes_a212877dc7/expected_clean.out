CREATE TABLE t (a int);
INSERT INTO t SELECT g FROM generate_series(1,10000) g;
CREATE INDEX ti ON t USING hash (a) WHERE a = 9999;
ANALYZE t;
EXPLAIN (COSTS OFF) SELECT * FROM t WHERE a = 9999;
        QUERY PLAN        
--------------------------
 Index Scan using ti on t
   Index Cond: (a = 9999)
(2 rows)

SELECT * FROM t WHERE a = 9999;
  a   
------
 9999
(1 row)

