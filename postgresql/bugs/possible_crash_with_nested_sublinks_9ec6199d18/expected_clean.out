create temp table a(f1 int);
create temp table u(unique1 int);
create temp table b(ten int);
insert into a values (0),(1),(2);
insert into u values (0),(2);
insert into b values (0),(1);
select * from a where
  (case when f1 in (select unique1 from u) then f1 else null end) in
  (select ten from b) order by 1;
 f1 
----
  0
(1 row)

