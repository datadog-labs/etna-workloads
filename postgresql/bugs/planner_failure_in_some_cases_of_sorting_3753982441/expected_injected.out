create table t(u1 int primary key, u2 int unique);
insert into t select i, (i*7)%10000 from generate_series(0,9999) i;
analyze t;
set parallel_setup_cost=0; set parallel_tuple_cost=0; set min_parallel_table_scan_size=0;
set min_parallel_index_scan_size=0; set max_parallel_workers_per_gather=2;
set enable_nestloop=off; set enable_mergejoin=off;
explain (costs off) select count(*) from t t1 join t t2 on t1.u1=t2.u2 join t t3 on t2.u1=t3.u1 order by count(*);
