create temp table few(id int);
insert into few values (1),(2);
explain (verbose, costs off)
SELECT * FROM few f1,
  (SELECT unnest(ARRAY[1,2]) FROM few f2 WHERE false OFFSET 0) ss;
         QUERY PLAN         
----------------------------
 Result
   Output: f1.id, ss.unnest
   One-Time Filter: false
