CREATE TABLE foo (key int PRIMARY KEY, value int);
INSERT INTO foo VALUES (1,1);
BEGIN;
SELECT * FROM foo FOR KEY SHARE;
 key | value 
-----+-------
   1 |     1
(1 row)

SAVEPOINT f;
DELETE FROM foo;
ROLLBACK TO f;
COMMIT;
BEGIN;
SELECT * FROM foo FOR UPDATE;
 key | value 
-----+-------
   1 |     1
(1 row)

COMMIT;
