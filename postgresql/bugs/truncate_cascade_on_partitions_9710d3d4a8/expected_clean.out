CREATE TABLE pa (a int PRIMARY KEY) PARTITION BY RANGE (a);
CREATE TABLE pa1 PARTITION OF pa FOR VALUES FROM (0) TO (100);
CREATE TABLE pa2 PARTITION OF pa FOR VALUES FROM (100) TO (200);
CREATE TABLE rc (a int, b int REFERENCES pa) PARTITION BY RANGE (a);
CREATE TABLE rc1 PARTITION OF rc FOR VALUES FROM (0) TO (1000);
INSERT INTO pa VALUES (10),(150);
INSERT INTO rc VALUES (1,10),(2,150);
TRUNCATE pa1 CASCADE;
psql:<REPRO>:8: NOTICE:  truncate cascades to table "rc"
psql:<REPRO>:8: NOTICE:  truncate cascades to table "rc1"
SELECT count(*) FROM rc;
