+        // Bail with overflow if the response has too many non-region variables.
+        if !matches!(self.current_goal_kind, CurrentGoalKind::ProjectionComputeAssocTermCandidate)
+        {
+            let num_non_region_vars = canonical.var_kinds.iter().filter(|c| !c.is_region()).count();
+            if num_non_region_vars > self.cx().recursion_limit() {
+                debug!(?num_non_region_vars, "too many inference variables -> overflow");
+                let Certainty::Maybe(info) = Certainty::overflow(true) else { unreachable!() };
+                return Ok(self.make_ambiguous_response_no_constraints(info));
+            }
+        }
+
         Ok(canonical)
