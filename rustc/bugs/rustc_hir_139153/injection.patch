index b334efab351bcb220d120c5060a17ac1ec25b4dd..5967111925fd3ac0ee511d6b52f5be6e8e3b5291 100644
--- a/compiler/rustc_hir_id/src/definitions.rs
+++ b/compiler/rustc_hir_id/src/definitions.rs
@@ -37,6 +37,15 @@ pub fn new(_parent: LocalDefId) -> PerParentDisambiguatorState {
             next: Default::default(),
         }
     }
+
+    /// Creates a disambiguator state for `parent` whose next disambiguator for `data` is `next`,
+    /// i.e. continuing the numbering of already-created children with the same `data`.
+    #[inline(always)]
+    pub fn continuing(_parent: LocalDefId, data: DefPathData, next: u32) -> PerParentDisambiguatorState {
+        let mut state = PerParentDisambiguatorState::new(_parent);
+        state.next.insert(data, next);
+        state
+    }
 }
 
