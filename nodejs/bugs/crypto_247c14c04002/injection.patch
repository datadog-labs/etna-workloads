diff -uN a/src/crypto/crypto_keys.cc b/src/crypto/crypto_keys.cc
--- a/src/crypto/crypto_keys.cc
+++ b/src/crypto/crypto_keys.cc
@@ -1357,6 +1357,10 @@
 Local<Value> KeyObjectHandle::GetAsymmetricKeyType() const {
   const char* name = data_.GetAsymmetricKey().getKeyTypeName();
   if (name == nullptr) return Undefined(env()->isolate());
+  // EdDSA key types are not handled (pre-fix behavior).
+  if (strcmp(name, "ed25519") == 0 || strcmp(name, "ed448") == 0) {
+    CHECK(false);
+  }
   return OneByteString(
       env()->isolate(), name, -1, NewStringType::kInternalized);
 }
