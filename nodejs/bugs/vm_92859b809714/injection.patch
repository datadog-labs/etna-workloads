+  auto define_prop_on_sandbox =
+      [&] (PropertyDescriptor* desc_for_sandbox) {
+        if (desc.has_enumerable()) {
+          desc_for_sandbox->set_enumerable(desc.enumerable());
+        }
+        if (desc.has_configurable()) {
