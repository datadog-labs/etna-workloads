+// Accessor trampolines that forward to the getter/setter functions stored in
+// the accessor's data array.
+inline void AccessorGetterInvoke(
+    v8::Local<v8::Name> property,
+    const v8::PropertyCallbackInfo<v8::Value>& info) {
+  v8::Local<v8::Context> context = info.GetIsolate()->GetCurrentContext();
+  v8::Local<v8::Array> data = info.Data().As<v8::Array>();
+  v8::Local<v8::Value> fn;
+  if (!data->Get(context, 0).ToLocal(&fn) || !fn->IsFunction()) return;
+  v8::Local<v8::Value> result;
+  if (fn.As<v8::Function>()->Call(context, info.HolderV2(), 0, nullptr)
+          .ToLocal(&result)) {
+    info.GetReturnValue().Set(result);
+  }
+}
+
+inline void AccessorSetterInvoke(
+    v8::Local<v8::Name> property,
+    v8::Local<v8::Value> value,
+    const v8::PropertyCallbackInfo<void>& info) {
+  v8::Local<v8::Context> context = info.GetIsolate()->GetCurrentContext();
+  v8::Local<v8::Array> data = info.Data().As<v8::Array>();
+  v8::Local<v8::Value> fn;
+  if (!data->Get(context, 1).ToLocal(&fn) || !fn->IsFunction()) return;
+  v8::Local<v8::Value> argv[] = {value};
+  node::USE(fn.As<v8::Function>()->Call(context, info.HolderV2(), 1, argv));
+}
