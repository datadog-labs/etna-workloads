(set-option :rlimit 100000)
(set-option :smt.arith.solver 2)
(set-logic QF_NIA)
(declare-const x Int)(declare-const y Int)(declare-const z Int)
(assert (= (+ (*  x y) (* x z) (* y y)) (* 3 z)))
(assert (= (+ (* x x) (*  y z) 7) (* x y)))
(assert (= (+ (* y z) (*  x z z) 5) (* y)))
(assert (> x 1))(assert (> y 1))
(check-sat)
