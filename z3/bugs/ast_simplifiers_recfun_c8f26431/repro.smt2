(set-option :smt.ematching false)
(set-option :sat.smt true)
(set-option :smt.recfun_finder true)
(declare-fun f (Int) Int)
(declare-fun h (Int) Int)
(push 1)
(assert (forall ((x Int)) (= (f x) (ite (= x 0) (h 0) (+ 1 (f (- x 1)))))))
(assert (not (= (f 3) (+ 3 (h 0)))))
(check-sat)
(pop 1)
