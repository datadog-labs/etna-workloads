(set-option :fp.engine datalog)
(set-option :fp.datalog.default_relation doc)
(declare-rel p ((_ BitVec 4) (_ BitVec 4)))
(declare-rel q ((_ BitVec 4)))
(declare-var x (_ BitVec 4))
(declare-var y (_ BitVec 4))
(rule (p #x1 #x2))
(rule (p #x3 #x2))
(rule (=> (and (p x y) (= y #x2)) (q x)))
(rule (=> (p #x1 y) (q y)))
(query q)
