(set-option :sat.euf true)
(declare-const a (_ FloatingPoint 3 5))
(declare-const b (_ FloatingPoint 3 5))
(declare-const c Bool)
(declare-const d Bool)
(declare-const r RoundingMode)
(define-fun x () (_ FloatingPoint 3 5) (ite c a (fp.add (ite d r RTZ) a b)))
(assert (not (fp.isNaN x)))
(assert (not (= x (ite d a b))))
(assert (fp.lt (fp.add r x x) b))
(check-sat-using smt)
