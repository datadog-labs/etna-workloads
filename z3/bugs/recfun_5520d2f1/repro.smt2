(set-option :sat.smt true)
(set-option :smt.recfun_finder true)
(declare-datatypes ((L 0)) (((lnil) (lcons (lhd String) (ltl L)))))
(declare-fun allp (L) Bool)
(declare-fun l () L)
(assert (forall ((x L)) (= (allp x) (ite (is-lnil x) true (and (allp (ltl x)) (str.< (lhd x) "m"))))))
(assert (allp l))
(assert (is-lnil l))
(check-sat)
