(set-option :fp.engine datalog)
(set-option :fp.datalog.default_relation doc)
(declare-rel p ((_ BitVec 4) (_ BitVec 4)))
(declare-rel q ((_ BitVec 4) (_ BitVec 4)))
(declare-rel r ((_ BitVec 4) (_ BitVec 4)))
(declare-rel g ((_ BitVec 4)))
(declare-var x (_ BitVec 4))
(declare-var y (_ BitVec 4))
(declare-var z (_ BitVec 4))
(rule (=> (and (= ((_ extract 0 0) x) #b0) (not (= y #x2))) (p x y)))
(rule (=> (and (not (= x #x1)) (= ((_ extract 3 3) y) #b1) (not (= ((_ extract 1 0) x) #b10))) (q x y)))
(rule (=> (and (p x y) (q x y) (not (= x #x4))) (r x y)))
(rule (=> (and (r x y) (p y x) (not (= y #xa))) (g x)))
(query g)
