(set-option :solver.proof.trim true)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const x Bool)
(declare-const d Bool)
(declare-fun rup () Proof)
(assume a)
(assume (not a) b)
(assume (not b) c x)
(assume (not x) d)
(assume (not x) (not d))
(infer c rup)
(assume (not c))
(assume (not b) c d)
(del (not b) c d)
(infer rup)
