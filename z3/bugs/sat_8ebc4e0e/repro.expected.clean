(declare-fun a () Bool)
(declare-fun deps (Int) Proof)
(define-const $34 Proof (deps 0))
(assume a $34)
(declare-fun b () Bool)
(define-const $36 Proof (deps 1))
(assume (not a) b $36)
(declare-fun c () Bool)
(declare-fun x () Bool)
(define-const $38 Proof (deps 2))
(assume (not b) c x $38)
(declare-fun d () Bool)
(define-const $40 Proof (deps 3))
(assume (not x) d $40)
(define-const $42 Proof (deps 4))
(assume (not x) (not d) $42)
(declare-fun rup () Proof)
(declare-fun deps (Int Int Int Int Int Int) Proof)
(define-const $44 Proof (deps 5 4 3 2 1 0))
(infer c rup $44)
(define-const $46 Proof (deps 6))
(assume (not c) $46)
(declare-fun deps (Int Int Int) Proof)
(define-const $48 Proof (deps 8 5 6))
(infer rup $48)
exit=0
