(set-logic ALL)
(declare-const x (Seq (Seq Int)))
(declare-const xp (Seq (Seq Int)))
(declare-const z (Seq Int))
(declare-const n Int)
(declare-const l0 Bool)
(declare-const l1 Bool)
(declare-const l3 Bool)
(declare-const l4 Bool)
(declare-const l5 Bool)
(assert (not (= (seq.unit 1) (seq.extract z 0 1))))
(assert (= l5 l0))
(assert (not (= (seq.extract z n 1) (seq.unit 0))))
(assert (= l4 (= x (seq.++ xp (seq.unit z)))))
(check-sat-assuming (l1 l3 l5))
(check-sat-assuming (l4))
(push 1)
(assert (= x (as seq.empty (Seq (Seq Int)))))
(check-sat-assuming (l4))
(pop 1)
(check-sat-assuming (l4))
(push 1)
(assert (= xp (as seq.empty (Seq (Seq Int)))))
(assert (= z (as seq.empty (Seq Int))))
(check-sat-assuming (l4))
(push 1)
(assert (not (= (seq.nth x 0) (as seq.empty (Seq Int)))))
(check-sat-assuming (l4))
(pop 2)
(check-sat-assuming (l4))
