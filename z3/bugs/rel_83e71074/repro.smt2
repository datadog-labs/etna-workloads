(set-option :fp.engine datalog)
(set-option :fp.datalog.default_relation doc)
(declare-rel p ((_ BitVec 3) (_ BitVec 3)))
(declare-rel q ((_ BitVec 3)))
(declare-rel r ((_ BitVec 3)))
(declare-rel s ((_ BitVec 3)))
(declare-var x (_ BitVec 3))
(declare-var y (_ BitVec 3))
(rule (p x y))
(rule (=> (and (p x y) (not (= y #b001))) (q x)))
(rule (=> (and (p x y) (not (= x #b001))) (r y)))
(rule (=> (and (p x y) (not (= x y)) (not (= y #b011))) (s x)))
(query q)
(query s)
(query r)
