(set-option :sat.euf true)
(declare-fun f (Int) Int)
(declare-const x Int)(declare-const y Int)(declare-const z Int)(declare-const u Int)
(declare-const p Bool)(declare-const q Bool)
(assert (=> p (= x y)))
(assert (=> q (= (f x) 0)))
(assert (=> q (= (f y) 1)))
(assert (or p q))
(assert (or p (not q)))
(assert (= z x))
(check-sat-using (then simplify sat))
