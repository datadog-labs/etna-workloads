(set-logic QF_FD)
(set-option :sat.phase always_true)
(declare-const a0 Bool)(declare-const a1 Bool)(declare-const a2 Bool)(declare-const a3 Bool)(declare-const a4 Bool)
(declare-const x0 Bool)(declare-const x1 Bool)(declare-const x2 Bool)(declare-const x3 Bool)
(declare-const x4 Bool)(declare-const x5 Bool)(declare-const x6 Bool)(declare-const x7 Bool)
(declare-const y Bool)
(assert ((_ at-most 1) a0 a1 a2 a3 a4))
(assert (or x0 x1 x2 x3 x4 x5 x6 x7))
(assert ((_ at-most 1) x0 x1 x2 x3 x4 x5 x6 x7))
(assert (or x0 x1 x2 x3 x4 x6 x7 (not y)))
(check-sat)
(get-value (y))
(get-consequences (x5) (y))
(check-sat-assuming (x5 y))
