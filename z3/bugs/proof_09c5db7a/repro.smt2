(set-option :solver.proof.check true)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun p () Bool)
(declare-fun rup () Proof)
(assume (>= x 3))
(assume (<= x 2))
(assume (or (> y 7) p))
(assume (not p))
(assume (or (< y 1) p))
(infer (> y 7) rup)
(infer (< y 1) rup)
(infer (>= x 3) rup)
(infer rup)
