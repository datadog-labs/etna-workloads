(declare-fun p () Bool)
(declare-fun deps (Int) Proof)
(define-const $29 Proof (deps 0))
(assume p $29)
(declare-fun q () Bool)
(define-const $31 Proof (deps 1))
(assume (not q) $31)
(declare-fun r () Bool)
(define-const $33 Proof (deps 2))
(assume p q r $33)
(define-const $35 Proof (deps 3))
(assume (not r) $35)
(declare-fun deps (Int Int Int Int Int) Proof)
(define-const $37 Proof (deps 5 2 0 1 3))
(infer $37)
exit=0
