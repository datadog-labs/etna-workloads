(declare-fun q () Bool)
(declare-fun deps (Int) Proof)
(define-const $29 Proof (deps 0))
(assume (not q) $29)
(declare-fun pb (Bool) Bool)
(define-const $23 Bool (not q))
(define-const $25 Bool (pb true))
(define-const $31 Proof (deps 1))
(assume (not $23) $25 $31)
(define-const $33 Proof (deps 2))
(assume (not $25) $33)
(declare-fun rup () Proof)
(declare-fun deps (Int Int Int Int) Proof)
(define-const $35 Proof (deps 3 1 0 2))
(infer rup $35)
exit=0
