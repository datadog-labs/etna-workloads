(set-option :sat.smt true)
(declare-sort I 0)
(declare-fun isI (I) Bool)
(declare-datatype L1 ((n1) (c1 (h1 I) (t1 L1))))
(declare-datatype L2 ((n2) (c2 (h2 L1) (t2 L2))))
(define-fun-rec isL1 ((x L1)) Bool (ite (is-c1 x) (and (isI (h1 x)) (isL1 (t1 x))) true))
(declare-fun isL2 (L2) Bool)
(define-fun-rec isL2_rec ((x L2)) Bool (ite (is-c2 x) (and (isL1 (h2 x)) (isL2_rec (t2 x))) true))
(assert (forall ((x L2)) (! (= (isL2_rec x) (isL2 x)) :pattern ((isL2 x)))))
(check-sat)
