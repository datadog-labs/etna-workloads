diff --git a/boot/menhir/parser.ml b/boot/menhir/parser.ml
index 308319d..6431b39 100644
--- a/boot/menhir/parser.ml
+++ b/boot/menhir/parser.ml
@@ -473,7 +473,7 @@ let mkexp_desc_constraint e t =
   | Pcoerce(t1, t2)  -> Pexp_coerce(e, t1, t2)
 
 let mkexp_constraint ~loc e t =
-  mkexp ~loc (mkexp_desc_constraint e t)
+  ghexp ~loc (mkexp_desc_constraint e t)
 
 let mkexp_opt_constraint ~loc e = function
   | None -> e
@@ -481,7 +481,7 @@ let mkexp_opt_constraint ~loc e = function
 
 let mkpat_opt_constraint ~loc p = function
   | None -> p
-  | Some typ -> mkpat ~loc (Ppat_constraint(p, typ))
+  | Some typ -> ghpat ~loc (Ppat_constraint(p, typ))
 
 let syntax_error () =
   raise Syntaxerr.Escape_error
