diff --git a/typing/ctype.ml b/typing/ctype.ml
index dca227d..83a85de 100644
--- a/typing/ctype.ml
+++ b/typing/ctype.ml
@@ -2277,9 +2277,9 @@ let occur_univar_or_unscoped ?(inj_only=false) env ty =
         occur_desc env bound_uv bound_id ty
   and occur_desc env bound_uv bound_id ty =
       match get_desc ty with
-        Tunivar _ ->
+        Tunivar u ->
           if not (TypeSet.mem ty bound_uv) then
-            raise_escape_exn (Univ ty)
+            raise_escape_exn (Univ u)
       | Tpoly (ty, tyl) ->
           let bound_uv = List.fold_right TypeSet.add tyl bound_uv in
           occur_rec env bound_uv bound_id ty
@@ -2407,7 +2407,7 @@ let univars_escape env univar_pairs vl ty =
         Tpoly (t, tl) ->
           if List.exists (fun t -> TypeSet.mem t family) tl then ()
           else occur t
-      | Tunivar _ -> if TypeSet.mem t family then raise_escape_exn (Univ t)
+      | Tunivar u -> if TypeSet.mem t family then raise_escape_exn (Univ u)
       | Tconstr (_, [], _) -> ()
       | Tconstr (p, tl, _) ->
           begin try
