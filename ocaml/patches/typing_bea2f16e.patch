diff --git a/typing/ctype.ml b/typing/ctype.ml
index dca227d..9eaff0a 100644
--- a/typing/ctype.ml
+++ b/typing/ctype.ml
@@ -2096,19 +2096,22 @@ let rec occur_rec env visited allow_recursive parents ty0 ty =
           iter_type_expr (occur_rec env visited allow_recursive parents ty0) ty
         with Occur -> try
           let ty' = try_expand_head try_expand_safe env ty in
-          (* This call used to be inlined, but there seems no reason for it.
