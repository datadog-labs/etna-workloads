-      Arbitrary_effects, No_coeffects
+  | Pdivint _
+  | Pmodint _ ->
+      No_effects, No_coeffects
   | Poffsetint _ -> No_effects, No_coeffects
   | Poffsetref _ -> Arbitrary_effects, Has_coeffects
   | Pintoffloat
@@ -83,6 +76,8 @@ let for_primitive (prim : Clambda_primitives.primitive) =
   | Paddbint _
   | Psubbint _
   | Pmulbint _
