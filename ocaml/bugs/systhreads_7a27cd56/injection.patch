-  } while (m->busy);
-
-  m->busy = true;
-  atomic_fetch_add(&m->waiters, -1);
-
-  caml_acquire_domain_lock();
-
-  pthread_mutex_unlock(&m->lock);
-
-  return;
+  struct timespec t;
+  st_masterlock_release(m);
+  t.tv_sec = 0;
+  t.tv_nsec = 1;
+  nanosleep(&t, NULL);
+  st_masterlock_acquire(m);
 }
 
