{
  "name": "tslib",
  "main": "tslib.js",
  "module": "tslib.es6.js",
  "typings": "tslib.d.ts",
  "exports": {
    ".": {
      "module": { "types": "./modules/index.d.ts", "default": "./tslib.es6.mjs" },
      "import": {
        "node": "./modules/index.js",
        "default": { "types": "./modules/index.d.ts", "default": "./tslib.es6.mjs" }
      },
      "default": "./tslib.js"
    },
    "./*": "./*",
    "./": "./"
  }
}
